# Copy to .env.production (or set in your host's build settings).
# Both are read at BUILD time and baked into the bundle.

# Backend origin, no trailing slash. Use https in production.
VITE_API_URL=https://api.example.com

# Optional. Defaults to VITE_API_URL with ws(s):// and /ws appended.
# VITE_WS_URL=wss://api.example.com/ws
